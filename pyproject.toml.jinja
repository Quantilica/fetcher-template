[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" },
]
license = "MIT"
license-files = ["LICENSE"]
requires-python = ">=3.12"
keywords = ["{{ source_id }}", "quantilica", "dados-abertos", "lake", "brazil"]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Environment :: Console",
    "Intended Audience :: Developers",
    "Intended Audience :: Information Technology",
    "Intended Audience :: Science/Research",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Topic :: Utilities",
    "Typing :: Typed",
]
dependencies = [
    "quantilica-core>=0.19.0",
]

[project.optional-dependencies]
analysis = [
    "polars>=1.0.0",
    "quantilica-analytics>=0.7.0",
]

[project.urls]
Homepage = "https://github.com/Quantilica/{{ package_name }}"
Repository = "https://github.com/Quantilica/{{ package_name }}"
Issues = "https://github.com/Quantilica/{{ package_name }}/issues"

[project.scripts]
{{ source_id }}-fetcher = "{{ package_slug }}.cli:main"

[project.entry-points."quantilica.fetchers"]
{{ source_id }} = "{{ package_slug }}.plugin:app"

{% if has_lake %}
[project.entry-points."quantilica.lake"]
{{ source_id }} = "{{ package_slug }}.lake:converter"
{% endif %}

[dependency-groups]
dev = [
    "pyright>=1.1.400",
    "ruff>=0.9.0",
    "pytest>=8.0.0",
    "pytest-cov>=7.1",
    "quantilica-cli>=0.22.0",
    "typer>=0.15.0",
    "rich>=13.0.0",
]

[tool.uv]
required-version = ">=0.9"

# Índices: o uv procura em ordem e para no primeiro que tem o pacote
# (index-strategy padrão first-index). O PyPI vem antes, então o índice
# Quantilica (GitHub Pages, que responde 503 intermitente a pacote que não
# hospeda) só é consultado para o que não está no PyPI (quantilica-analytics).
# Sem [tool.uv.sources]: no workspace do monorepo quantilica-analytics é membro
# e uma fonte de índice aqui quebraria o `uv run` da raiz.
[[tool.uv.index]]
name = "pypi"
url = "https://pypi.org/simple/"

[[tool.uv.index]]
name = "quantilica"
url = "https://index.quantilica.com/simple/"

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
addopts = ["-p", "no:cacheprovider"]

[tool.ruff]
line-length = 88

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_slug }}"]

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[tool.pyright]
typeCheckingMode = "basic"
include = ["src"]

[tool.coverage.run]
source = ["{{ package_slug }}"]

[tool.coverage.report]
show_missing = true
skip_covered = true
